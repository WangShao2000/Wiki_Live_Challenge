# Wiki Live Challenge Configuration
# Copy this file to .env and fill in your API keys

# ============================================
# Jina Reader API (for web content fetching)
# ============================================
JINA_API_KEY=your_jina_api_key_here
JINA_BASE_URL=https://r.jina.ai/

# ============================================
# Statement Extraction Model (preprocessing)
# Used for: Extracting statements from markdown articles
# ============================================
EXTRACT_MODEL=gemini-2.5-flash
EXTRACT_API_KEY=your_extract_api_key_here
EXTRACT_BASE_URL=your_extract_api_base_url_here

# ============================================
# Fact Verification Model (Wiki Fact evaluation)
# Used for: Verifiability & Citation evaluation
# ============================================
VERIFIER_MODEL=gemini-2.5-flash
VERIFIER_API_KEY=your_verifier_api_key_here
VERIFIER_BASE_URL=your_verifier_api_base_url_here

# ============================================
# Writing Evaluation Model (Wiki Writing evaluation)
# Used for: Criteria-based writing quality evaluation
# Recommended: Use a more capable model (e.g., gemini-2.5-pro)
# Falls back to VERIFIER_* if not set
# ============================================
WRITING_MODEL=gemini-2.5-pro
WRITING_API_KEY=your_writing_api_key_here
WRITING_BASE_URL=your_writing_api_base_url_here

# ============================================
# OpenAI Embedding API (for verifiability)
# Used for: Semantic similarity in verifiability evaluation
# ============================================
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_BASE_URL=https://api.openai.com/v1
EMBEDDING_MODEL=text-embedding-3-small

# ============================================
# Processing Settings
# ============================================
API_TIMEOUT=300
MAX_RETRIES=3
CONCURRENCY=10
